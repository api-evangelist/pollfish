      "id": "202b13ea-0619-4f25-a749-2040294c6af3",
      "name": "Survey Distribution",
      "description": {
        "content": "Device register, offerwall, and survey rendering.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "768fac33-6df2-477d-bb20-dbfc414da1bb",
          "name": "Request a survey / offerwall for a device",
          "request": {
            "name": "Request a survey / offerwall for a device",
            "description": {
              "content": "Requests a matching survey (or, with `offerwall=true`, an offerwall) for a respondent device. All register parameters are passed inside the `json` query parameter as a JSON string; `dontencrypt=true` must be included. With `offerwall=true` and `content_type=json`, returns a JSON list of surveys with reward and remaining-completes data; otherwise returns an HTML page. Response is HTTP 200 when a survey is available, 204 when none is available. This host is wss.pollfish.com but the call is a normal HTTPS GET, not a WebSocket connection.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v2",
                "device",
                "register",
                "true"
              ],
              "host": [
                "wss",
                "pollfish",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) URL-encoded JSON object carrying all register parameters (api_key, device_id, timestamp, ip, os, locale, version, encryption, placement_key, offerwall, content_type, reward_name, reward_conversion, click_id, targeting demographics, etc.). See the register JSON schema."
                },
                {
                  "disabled": false,
                  "key": "device_id",
                  "value": "<string>",
                  "description": "(Required) URL-encoded JSON object carrying all register parameters (api_key, device_id, timestamp, ip, os, locale, version, encryption, placement_key, offerwall, content_type, reward_name, reward_conversion, click_id, targeting demographics, etc.). See the register JSON schema."
